# Server Port & Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (local MongoDB instance)
MONGODB_URI=mongodb://127.0.0.1:27017/repolens

# Google Gemini API Configuration (obtain from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

